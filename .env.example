# ==========================================
# SIS CYBER FORTRESS — ENVIRONMENT VARIABLES
# ==========================================

# --- Server & Runtime ---
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sis_cyber_fortress?schema=public"

# --- Security & JWT ---
JWT_SECRET=super_strong_high_entropy_jwt_secret_key_minimum_32_characters_here
JWT_EXPIRES_IN=1d
COOKIE_SECRET=super_strong_cookie_signing_secret_here

# --- Super Admin Initial Bootstrap ---
BOOTSTRAP_ADMIN_EMAIL=superadmin@sisfortress.cyber
BOOTSTRAP_ADMIN_PASSWORD=Fortress#SuperAdmin2026!
BOOTSTRAP_ADMIN_NAME="Chief Security Officer"

# --- Next.js Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_NAME="SIS CYBER FORTRESS"

# --- External Provider Integrations (Optional / Set when available) ---
# Firebase Cloud Messaging
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Threat Intel Feeds
THREAT_FEED_API_KEY=
THREAT_FEED_URL=

# Breach Monitoring
BREACH_API_KEY=
